FORGE_ENV=development
FORGE_LOG_LEVEL=INFO
FORGE_AUTO_COMMIT_THRESHOLD=85
FORGE_REVIEW_THRESHOLD=50
# ASR
FORGE_WHISPER_MODEL=base
FORGE_WHISPER_DEVICE=auto
FORGE_WHISPER_COMPUTE_TYPE=int8

# Optional local VLM verifier (OpenAI-compatible endpoint)
FORGE_VLM_ENABLED=false
FORGE_VLM_BASE_URL=http://127.0.0.1:1234/v1
FORGE_VLM_API_KEY=not-required
FORGE_VLM_MODEL=local-vlm
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here