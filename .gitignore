# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Environment / secrets
.env
.env.local
.env.*.local

# OS junk
.DS_Store
Thumbs.db

# Runtime storage artifacts (keep .gitkeep placeholders)
storage/raw/*
storage/processed/*
storage/exports/*
!storage/raw/.gitkeep
!storage/processed/.gitkeep
!storage/exports/.gitkeep

# AI model weights (repo rule: do not commit weights)
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.gguf
weights/
models/

# Logs
*.log

# Node (frontend has its own .gitignore, belt-and-braces)
node_modules/
dist/